{
  "name": "@workerstack/ui",
  "version": "0.0.0",
  "private": false,
  "description": "Fast, SSR-ready Solid 2 components on UI SDK, styled with Tailwind",
  "keywords": [
    "solid",
    "solid-js",
    "tailwind",
    "ui",
    "ui-sdk",
    "workerstack"
  ],
  "homepage": "https://github.com/workerstack/ui/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/workerstack/ui/issues"
  },
  "license": "MIT",
  "author": "Lovro \u017dagar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/workerstack/ui.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./cn": {
      "types": "./dist/cn/index.d.ts",
      "default": "./dist/cn/index.js"
    },
    "./locale": {
      "types": "./dist/locale/index.d.ts",
      "default": "./dist/locale/index.js"
    },
    "./button": {
      "types": "./dist/button/index.d.ts",
      "solid": "./dist/button/index.js",
      "default": "./dist/button/index.js"
    },
    "./field": {
      "types": "./dist/field/index.d.ts",
      "solid": "./dist/field/index.js",
      "default": "./dist/field/index.js"
    },
    "./input": {
      "types": "./dist/input/index.d.ts",
      "solid": "./dist/input/index.js",
      "default": "./dist/input/index.js"
    },
    "./select": {
      "types": "./dist/select/index.d.ts",
      "solid": "./dist/select/index.js",
      "default": "./dist/select/index.js"
    },
    "./provider": {
      "types": "./dist/provider/index.d.ts",
      "solid": "./dist/provider/index.js",
      "default": "./dist/provider/index.js"
    },
    "./dialog": {
      "types": "./dist/dialog/index.d.ts",
      "solid": "./dist/dialog/index.js",
      "default": "./dist/dialog/index.js"
    },
    "./menu": {
      "types": "./dist/menu/index.d.ts",
      "solid": "./dist/menu/index.js",
      "default": "./dist/menu/index.js"
    },
    "./text-input": {
      "types": "./dist/text-input/index.d.ts",
      "solid": "./dist/text-input/index.js",
      "default": "./dist/text-input/index.js"
    },
    "./textarea": {
      "types": "./dist/textarea/index.d.ts",
      "solid": "./dist/textarea/index.js",
      "default": "./dist/textarea/index.js"
    },
    "./checkbox": {
      "types": "./dist/checkbox/index.d.ts",
      "solid": "./dist/checkbox/index.js",
      "default": "./dist/checkbox/index.js"
    },
    "./switch": {
      "types": "./dist/switch/index.d.ts",
      "solid": "./dist/switch/index.js",
      "default": "./dist/switch/index.js"
    },
    "./radio-group": {
      "types": "./dist/radio-group/index.d.ts",
      "solid": "./dist/radio-group/index.js",
      "default": "./dist/radio-group/index.js"
    },
    "./combobox": {
      "types": "./dist/combobox/index.d.ts",
      "solid": "./dist/combobox/index.js",
      "default": "./dist/combobox/index.js"
    },
    "./popover": {
      "types": "./dist/popover/index.d.ts",
      "solid": "./dist/popover/index.js",
      "default": "./dist/popover/index.js"
    },
    "./tooltip": {
      "types": "./dist/tooltip/index.d.ts",
      "solid": "./dist/tooltip/index.js",
      "default": "./dist/tooltip/index.js"
    },
    "./alert-dialog": {
      "types": "./dist/alert-dialog/index.d.ts",
      "solid": "./dist/alert-dialog/index.js",
      "default": "./dist/alert-dialog/index.js"
    },
    "./drawer": {
      "types": "./dist/drawer/index.d.ts",
      "solid": "./dist/drawer/index.js",
      "default": "./dist/drawer/index.js"
    },
    "./tabs": {
      "types": "./dist/tabs/index.d.ts",
      "solid": "./dist/tabs/index.js",
      "default": "./dist/tabs/index.js"
    },
    "./badge": {
      "types": "./dist/badge/index.d.ts",
      "solid": "./dist/badge/index.js",
      "default": "./dist/badge/index.js"
    },
    "./card": {
      "types": "./dist/card/index.d.ts",
      "solid": "./dist/card/index.js",
      "default": "./dist/card/index.js"
    },
    "./toast": {
      "types": "./dist/toast/index.d.ts",
      "solid": "./dist/toast/index.js",
      "default": "./dist/toast/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/theme.css dist/theme.css",
    "dev": "bun scripts/dev.ts",
    "prepublishOnly": "bun run build",
    "test": "vitest run",
    "test:browser": "vitest run --project browser",
    "test:dom": "vitest run --project dom",
    "test:hydration": "vitest run --project hydration",
    "test:server": "vitest run --project server",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@solidjs/testing-library": "catalog:",
    "@solidjs/vite-plugin": "catalog:",
    "@solidjs/web": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@ui-sdk/core": "catalog:",
    "@ui-sdk/solid": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "cn": "catalog:",
    "playwright": "catalog:",
    "solid-js": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@solidjs/web": ">=2.0.0-rc.20 <3",
    "@ui-sdk/core": "^0.1.0-beta.2",
    "@ui-sdk/solid": "^0.1.0-beta.2",
    "cn": "^0.5.2",
    "solid-js": ">=2.0.0-rc.20 <3",
    "tailwindcss": "^4.3.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
