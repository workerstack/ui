{
  "name": "@workerstack/ui",
  "version": "0.0.0",
  "private": false,
  "description": "Fast, SSR-ready Solid 2 components on UI SDK, styled with Tailwind",
  "keywords": [
    "solid",
    "solid-js",
    "tailwind",
    "ui",
    "ui-sdk",
    "workerstack"
  ],
  "homepage": "https://github.com/workerstack/ui/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/workerstack/ui/issues"
  },
  "license": "MIT",
  "author": "Lovro \u017dagar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/workerstack/ui.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "solid": "./dist/components/*/index.js",
      "default": "./dist/components/*/index.js"
    },
    "./features/*": {
      "types": "./dist/features/*/index.d.ts",
      "default": "./dist/features/*/index.js"
    },
    "./utils/*": {
      "types": "./dist/utils/*/index.d.ts",
      "default": "./dist/utils/*/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/theme.css dist/theme.css",
    "dev": "bun scripts/dev.ts",
    "prepublishOnly": "bun run build",
    "test": "vitest run",
    "test:browser": "vitest run --project browser",
    "test:dom": "vitest run --project dom",
    "test:hydration": "vitest run --project hydration",
    "test:server": "vitest run --project server",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@solidjs/testing-library": "catalog:",
    "@solidjs/vite-plugin": "catalog:",
    "@solidjs/web": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/solid-form": "catalog:",
    "@types/node": "catalog:",
    "@ui-sdk/core": "catalog:",
    "@ui-sdk/solid": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "cn": "catalog:",
    "playwright": "catalog:",
    "solid-js": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@solidjs/web": ">=2.0.0-rc.20 <3",
    "@tanstack/solid-form": ">=1.33.0",
    "@ui-sdk/core": "^0.1.0-beta.2",
    "@ui-sdk/solid": "^0.1.0-beta.2",
    "cn": "^0.5.2",
    "solid-js": ">=2.0.0-rc.20 <3",
    "tailwindcss": "^4.3.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/solid-form": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
